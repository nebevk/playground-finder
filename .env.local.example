# Copy to .env.local for local development. Production values live in Vercel.

# --- Supabase (required) ---
# Local stack (pnpm db:start) prints these; production values are in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Server-only — never expose with a NEXT_PUBLIC_ prefix.
# Required for photo uploads, account deletion and admin actions.
SUPABASE_SECRET_KEY=

# --- Site URL (required in production) ---
# Canonical origin used in auth emails (signup confirmation, password reset)
# and SEO metadata. On Vercel set this to the production domain, e.g.
# https://playground-finder-seven.vercel.app — without it, Vercel's production
# URL is used as a fallback, and localhost only in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (spam protection; required in production) ---
# Leave both empty locally. Production needs both: the site key renders the widget,
# the secret key verifies tokens server-side. Vercel production builds fail without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error tracking (optional; Sentry, EU region) ---
# Leave empty locally. Production: the DSN of a Sentry project created in the EU region
# (https://<key>@o<id>.ingest.de.sentry.io/<project>). Without it the SDK isn't even downloaded.
NEXT_PUBLIC_SENTRY_DSN=

# --- GDPR contact (required in production) ---
# Monitored inbox shown on /privacy and /terms for data requests. Locally a placeholder
# is shown; Vercel production builds fail without it.
NEXT_PUBLIC_PRIVACY_EMAIL=
